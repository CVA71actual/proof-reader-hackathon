{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-reader.local/schema/decision.schema.json",
  "title": "Proof Reader decision",
  "description": "One line of decisions.jsonl. Lines are only ever appended; an undo is a new line, never an edit. A person writes keep, fix, remove, undo, same_event and distinct_events; code writes recheck after running the checks again on a person's fix.",
  "type": "object",
  "additionalProperties": false,
  "required": ["at", "target", "action", "note", "fix", "by"],
  "properties": {
    "at": {"type": "string", "format": "date-time"},
    "target": {"type": "string", "description": "A row id or a table cell id from run.json."},
    "action": {"enum": ["keep", "fix", "remove", "undo", "recheck", "same_event", "distinct_events"]},
    "duplicate_of": {"type": "string", "description": "same_event / distinct_events only: the row id of the other copy of the event (DUPLICATE-RESOLUTION-001). same_event: this row is a second source of that row, not a second calendar entry. distinct_events: the person says the two rows are different events (a note is required)."},
    "note": {"type": ["string", "null"]},
    "fix": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "from", "to"],
          "properties": {
            "field": {"type": "string"},
            "from": {"type": ["string", "array", "null"], "items": {"type": "string"}},
            "to": {"type": ["string", "array", "null"], "items": {"type": "string"}}
          },
          "allOf": [{
            "if": {"properties": {"field": {"const": "conditions"}}},
            "then": {"properties": {"from": {"type": ["array", "null"]}, "to": {"type": ["array", "null"]}}},
            "else": {"properties": {"from": {"type": ["string", "null"]}, "to": {"type": ["string", "null"]}}}
          }]
        },
        {"type": "null"}
      ]
    },
    "review_basis": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
      "properties": {"version": {"const": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "description": "Server-computed effective proposal/evidence identity at human Keep; never backfilled on load."
    },
    "by": {"enum": ["person", "code"]},
    "recheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "reason", "checks", "before", "after"],
      "properties": {
        "result": {"enum": ["pass", "fail", "could_not_run"]},
        "reason": {"type": "string"},
        "checks": {"type": "array", "items": {"type": "object"}},
        "before": {"$ref": "#/$defs/run_of_checks", "description": "The same checks on the item as it was before the fix (the old value)."},
        "after": {"$ref": "#/$defs/run_of_checks", "description": "The checks on the fixed item (the new value); the same as result and checks."}
      }
    }
  },
  "$defs": {
    "run_of_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "checks"],
      "properties": {
        "result": {"enum": ["pass", "fail", "could_not_run"]},
        "checks": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "fix"}}},
      "then": {"properties": {"fix": {"type": "object"}}},
      "else": {"properties": {"fix": {"type": "null"}}}
    },
    {
      "if": {"properties": {"action": {"const": "recheck"}}},
      "then": {"properties": {"by": {"const": "code"}}, "required": ["recheck"]},
      "else": {"properties": {"by": {"const": "person"}}, "not": {"required": ["recheck"]}}
    }
  ]
}
