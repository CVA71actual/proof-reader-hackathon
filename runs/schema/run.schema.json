{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-reader.local/schema/run.schema.json",
  "title": "Proof Reader run",
  "description": "One run, written once when the run ends and never edited afterwards (a run started from the New run panel is rewritten by its job only while it is going; once its status is done it is never written again). A person's later actions live in decisions.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "sources", "tables", "rows", "mistakes", "exclusions"],
  "properties": {
    "schema_version": {"const": "1"},
    "run": {"$ref": "#/$defs/run"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "mistakes": {"type": "array", "items": {"$ref": "#/$defs/mistake"},
                 "description": "Genuine errors only: a proposed value that was wrong and got changed, or a row removed because its content was wrong."},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"},
                   "description": "Rows left out under a rule (house rule, past event, a person's choice). Not mistakes."},
    "report_stale": {"type": "boolean", "description": "True when a saved report cannot be served because its source state changed and rebuild failed."},
    "report_stale_reason": {"type": "string", "description": "Why saved reports remain unavailable until rebuilt."},
    "accuracy_stale": {"type": "boolean", "description": "True when saved accuracy scoring no longer describes this run."},
    "accuracy_stale_reason": {"type": "string", "description": "Why saved accuracy scoring must be regenerated."},
    "id_repairs": {
      "description": "Explicit, zero-based mapping used only by python -m runs.repair_ids; no IDs are inferred. On successful --write, applied is true and the mapping remains as an audit record.",
      "type": "object",
      "properties": {
        "applied": {"const": true},
        "targets": {"type": "array", "items": {"type": "object", "required": ["path", "from", "to"], "properties": {"path": {"type": "array", "items": {"type": ["string", "integer"]}}, "from": {"type": "string"}, "to": {"type": "string"}}}},
        "references": {"type": "array", "items": {"type": "object", "required": ["path", "from", "to"], "properties": {"path": {"type": "array", "items": {"type": ["string", "integer"]}}, "from": {"type": "string"}, "to": {"type": "string"}}}},
        "decisions": {"type": "array", "items": {"type": "object", "required": ["line", "from", "to"], "properties": {"line": {"type": "integer", "minimum": 0}, "from": {"type": "string"}, "to": {"type": "string"}}}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "iso_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rel_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"},
    "box": {
      "description": "[x0, y0, x1, y1] in PDF points, origin top-left, y grows downward; null when the reader proposed no place.",
      "oneOf": [
        {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        {"type": "null"}
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "label", "sample", "started_at", "finished_at", "choices", "spend_usd"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "number": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1},
        "sample": {"type": "boolean"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "The run's one reference date (ISO). Absent = the day it started."},
        "finished_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}],
                        "description": "null while the run is going (any status but done)."},
        "choices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["companies", "event_types", "time_window_months", "spending_limit_usd", "note_for_agent"],
          "properties": {
            "companies": {"type": "array", "items": {"type": "string"}},
            "event_types": {"type": "array", "items": {"type": "string"}},
            "time_window_months": {"type": ["integer", "null"], "minimum": 1},
            "spending_limit_usd": {"type": ["number", "null"], "minimum": 0},
            "note_for_agent": {"type": ["string", "null"]},
            "reader_tools": {"type": "boolean", "description": "Whether the first reader could call the checks as tools while it read (capture/reader_tools.py). Absent on a run saved before it existed: false."},
            "models": {"enum": ["one", "all"], "description": "one: Muse Spark only (no second reader, no Muse Wonder escalation, no SAM 3.1); all: the usual set. Absent on a run saved before it existed: all."},
            "mode": {"enum": ["pages", "research"], "description": "pages: read the captured pages of the sources index (the default; absent on a run saved before research existed). research: RESEARCHER-FULL-001, Muse Spark researches each company on the Responses API with web_search and the capture tools (runs/research.py); every source it cites is captured by code."},
            "research_limits": {"type": "object", "additionalProperties": false, "description": "Optional settings of a research run, each null (off) unless a person turned it on; concurrency is a rate-limit safety setting (work queues, none is dropped).",
                                "properties": {"max_spend_per_company_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
                                               "max_requests_per_company": {"type": ["integer", "null"], "minimum": 1},
                                               "max_searches_per_company": {"type": ["integer", "null"], "minimum": 1},
                                               "max_searches_per_request": {"type": ["integer", "null"], "minimum": 1},
                                               "max_fetches_per_company": {"type": ["integer", "null"], "minimum": 1},
                                               "max_pages_per_company": {"type": ["integer", "null"], "minimum": 1},
                                               "max_minutes_per_company": {"type": ["number", "null"], "exclusiveMinimum": 0},
                                               "stop_on_empty_rate": {"type": "boolean"},
                                               "concurrency": {"type": "integer", "minimum": 1, "maximum": 10}}}
          }
        },
        "spend_usd": {"type": ["number", "null"], "minimum": 0, "description": "The sum of the cost_usd of every Model step in the rows' trails; null when the spend was not recorded."},
        "prices": {
          "type": "object",
          "description": "The price table in force when the run was made (runs/prices.py). Absent on a run saved before 2026-10-29: its recorded spend is kept as recorded.",
          "required": ["per_1m_tokens_usd", "per_image_usd"],
          "additionalProperties": false,
          "properties": {
            "per_1m_tokens_usd": {"type": "object", "additionalProperties": {
              "type": "object", "required": ["input", "output"],
              "properties": {"input": {"type": "number"}, "output": {"type": "number"}, "cached_input": {"type": "number"}}}},
            "per_image_usd": {"type": "object", "additionalProperties": {"type": "number"}},
            "per_hour_usd": {"type": "object", "additionalProperties": {"type": "number"}},
            "per_1k_searches_usd": {"type": "object", "additionalProperties": {"type": "number"}, "description": "US dollars per 1,000 built-in web searches (Responses API search grounding)."},
            "per_1k_requests_usd": {"type": "object", "additionalProperties": {"type": "number"}, "description": "US dollars per 1,000 requests to a per-request priced search API (Brave Search)."}
          }
        },
        "status": {"enum": ["queued", "running", "paused_turn_limit", "needs_input", "done", "failed"],
                   "description": "Run controls (server/jobs.py). Absent on a run saved before they existed: it is finished."},
        "status_reason": {"type": "string", "description": "One plain sentence for the status."},
        "turn_count": {"type": "integer", "minimum": 0, "description": "Model calls used in the current budget of turns."},
        "turn_limit": {"type": "integer", "minimum": 1, "description": "The budget of turns; a resume starts a fresh one."},
        "reader_tools": {"type": "object", "description": "Only on a run with the reader_tools choice on: what the first reader's tool use came to (path native or json_request; model calls, tool calls, how many of them ran, re-reads, answers that were fail).",
                         "properties": {"path": {"enum": ["native", "json_request"]}, "model_calls": {"type": "integer"},
                                        "tool_calls": {"type": "integer"}, "tool_calls_run": {"type": "integer"},
                                        "rereads": {"type": "integer"}, "failed_answers": {"type": "integer"}}},
        "turns_total": {"type": "integer", "minimum": 0, "description": "Every model call in the run."},
        "resumes": {"type": "integer", "minimum": 0},
        "unpriced_calls": {"type": "integer", "minimum": 0, "description": "Optional. Calls under a spending limit whose cost could not be priced (job.json keeps the count); while above 0 the limit bounds counted spend only."},
        "pages_total": {"type": "integer", "minimum": 0, "description": "Pages selected from the source index for this run, when recorded."},
        "pages_read": {"type": "integer", "minimum": 0, "description": "Selected pages successfully read into this run, when recorded."},
        "pages_unread": {"type": "integer", "minimum": 0, "description": "Selected pages without a successful interpretation."},
        "page_outcomes": {"type": "array", "description": "One record per selected page. Capture, attempt, read, unreadable, skipped and unread are separate facts.",
                          "items": {"type": "object", "additionalProperties": false,
                            "required": ["source_id", "ticker", "company", "page_number", "captured", "attempted", "read", "unreadable", "skipped", "unread"],
                            "properties": {"source_id": {"$ref": "#/$defs/id"}, "ticker": {"type": "string"},
                              "company": {"type": "string"}, "page_number": {"type": ["integer", "null"], "minimum": 1},
                              "captured": {"type": "boolean"}, "attempted": {"type": "boolean"},
                              "read": {"type": "boolean"}, "unreadable": {"type": "boolean"},
                              "skipped": {"type": "boolean"}, "unread": {"type": "boolean"},
                              "reason": {"type": "string"},
                              "capture_warning": {"type": ["object", "null"]}}}},
        "skipped_pages": {"type": "array", "description": "Optional. Pages the job left undone and why: a page whose files no longer match the index, or one that stopped the run twice (server/jobs.py). What was read of them before stays.",
                          "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "ticker", "reason"],
                                    "properties": {"source_id": {"type": "string"}, "ticker": {"type": "string"},
                                                   "reason": {"type": "string"}}}},
        "escalation": {"type": "object", "additionalProperties": false,
                       "required": ["model", "status", "rows_sent", "rows_replaced"],
                       "properties": {"model": {"type": "string"}, "status": {"enum": ["read", "not_run"]},
                                      "rows_sent": {"type": "integer", "minimum": 0},
                                      "rows_replaced": {"type": "integer", "minimum": 0},
                                      "reason": {"type": ["string", "null"]}},
                       "description": "Optional. Rows sent to Muse Wonder because a check failed or the readers disagreed, and how many took its re-read after it passed every check (runs/escalate.py)."},
        "second_reader": {"type": "object", "additionalProperties": false, "required": ["model", "status"],
                          "properties": {"model": {"type": ["string", "null"]},
                                         "status": {"enum": ["read", "not_run", "unreadable"]},
                                         "input": {"enum": ["image", "image_and_words", "words"],
                                                   "description": "What the second reader was given: the page image alone (its read does not depend on the text layer), the image and the words (fallback), or the words."},
                                         "reason": {"type": ["string", "null"]}},
                          "description": "Optional. Whether the second reader read this run's pages (server/jobs.py) and why not if it did not."},
        "trail": {"type": "array", "items": {"$ref": "#/$defs/trail_step"},
                  "description": "Run-level Person steps, e.g. a raised spending limit. Absent when there are none."},
        "research": {"type": "object", "required": ["label", "companies", "steps", "manifest"],
                     "properties": {"label": {"const": "Agent research — not independently reviewed"},
                                    "companies": {"type": "object"}, "steps": {"type": "array", "items": {"type": "object"}},
                                    "manifest": {"type": "object"}, "limits": {"type": "object"},
                                    "refusals": {"type": "array"}, "coverage": {"type": "array"},
                                    "audit": {"type": ["object", "null"]}, "review": {"type": "object"}},
                     "description": "Optional. A research run's ledger (runs/research.py): per-company progress, limits and recorded limitations, the Agent trail steps (search, fetch, proposal, check), the run-owned source manifest summary, refused proposals, coverage notes and the draft audit. See runs/README.md."}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publisher", "kind", "title", "url", "published_date", "captured_at", "sha256", "pages"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "publisher": {"type": "string"},
        "kind": {"enum": ["filing", "company_release", "third_party_calendar", "other"]},
        "title": {"type": "string"},
        "url": {"type": ["string", "null"]},
        "published_date": {"oneOf": [{"$ref": "#/$defs/iso_date"}, {"type": "null"}]},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                   "description": "sha256 of the document the pages were cut from (for a rendered source: the rendered PDF)."},
        "rendered_from": {
          "description": "Optional. Set when the source is held only as HTML and its pages were rendered by code: the screens then say \"page rendered by code from the filed HTML\".",
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "renderer"],
          "properties": {
            "format": {"const": "html"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the filed HTML, as fetched from url."},
            "renderer": {"type": "string", "minLength": 1},
            "limitations": {"type": "array", "items": {"type": "string"}, "description": "Optional. What the isolated renderer (capture/exhibit_render.py) did not show or apply, from the verified render record, or why that record could not be used. Shown with the source in the reader and the report."},
            "render_record": {
              "type": "object", "additionalProperties": false,
              "required": ["file", "sha256", "status", "assets_consumed", "assets_omitted"],
              "description": "Optional. The verified subset of the exhibit's render record (<pdf>.render.json), read only when its bytes match the SHA-256 the capture index recorded.",
              "properties": {
                "file": {"type": ["string", "null"]},
                "sha256": {"type": ["string", "null"]},
                "status": {"enum": ["verified", "unavailable", "changed"]},
                "assets_consumed": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {"name": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": ["integer", "null"]}, "media_type": {"type": "string"}}}},
                "assets_omitted": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ref", "reason"], "properties": {"ref": {"type": "string"}, "reason": {"type": "string"}}}}
              }
            }
          }
        },
        "retrieval": {"type": "object", "required": ["tool", "requested_url", "final_url", "retrieved_at", "content_type", "original_sha256", "original_bytes", "manifest_seq"],
                      "description": "Optional. A source fetched by the research agent's tools (runs/research.py): what was asked for, where it came from, when, and the hash of the exact bytes received (kept in the run folder under research/captures/).",
                      "properties": {"tool": {"enum": ["fetch_url", "fetch_edgar", "fetch_ctgov"]}, "requested_url": {"type": "string"}, "final_url": {"type": "string"},
                                     "retrieved_at": {"$ref": "#/$defs/timestamp"}, "http_status": {"type": ["integer", "null"]},
                                     "content_type": {"type": ["string", "null"]}, "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                                     "original_bytes": {"type": "integer", "minimum": 0}, "original_file": {"type": "string"},
                                     "rendered": {"type": "object"}, "manifest_seq": {"type": "integer", "minimum": 1},
                                     "ticker": {"type": "string"}, "call_id": {"type": "string"}, "pages_total": {"type": "integer", "minimum": 0},
                                     "pages_captured": {"type": "integer", "minimum": 0}, "page_cap_reason": {"type": ["string", "null"]}}},
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["page_number", "image", "width_pt", "height_pt", "words", "image_sha256", "words_sha256"],
            "properties": {
              "page_number": {"type": "integer", "minimum": 1},
              "image": {"$ref": "#/$defs/rel_path"},
              "width_pt": {"type": "number", "exclusiveMinimum": 0},
              "height_pt": {"type": "number", "exclusiveMinimum": 0},
              "words": {"$ref": "#/$defs/rel_path"},
              "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the page image file in the run folder."},
              "words_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the words file in the run folder."},
              "visual_evidence": {"type": "object", "additionalProperties": false,
                "required": ["origin", "overlays_supported", "reason"],
                "properties": {"origin": {"enum": ["text_layer", "hidden_text", "approximate", "no_text_layer"]},
                  "overlays_supported": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}},
              "capture_completeness": {"type": "object", "additionalProperties": false,
                "properties": {"capture_incomplete": {"type": "boolean"},
                  "capture_incomplete_reason": {"type": "string"}, "certified_complete": {"type": "boolean"},
                  "completeness_not_established": {"type": "boolean"}, "completeness_reason": {"type": "string"}}},
              "derived_words": {"type": "object", "additionalProperties": false,
                "required": ["kind", "file", "sha256", "based_on_image_sha256", "geometry", "models"],
                "properties": {"kind": {"const": "model_transcription"}, "file": {"$ref": "#/$defs/rel_path"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "based_on_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "geometry": {"const": "approximate"}, "models": {"type": "array", "items": {"type": "string"}}}},
          "kind": {"const": "picture", "description": "Optional. The page's own text layer is a hidden strip (a slide saved as a picture); its words file was rebuilt by SAM 3.1 and an image reader (runs/picture.py)."},
          "words_from": {"type": "string", "description": "Optional, on a picture page: where the words came from (\"sam+image reader\")."},
          "note": {"type": "string", "description": "Optional. A plain sentence for the screens about the page's words."},
          "scanned": {"const": true, "description": "Optional. The page has no text layer (a scan): its words file holds no words."},
          "regions": {"type": "array", "description": "Optional, on a scanned page: the regions SAM 3.1 found, in PDF points (runs/scan.py).",
                      "items": {"type": "object", "additionalProperties": false, "required": ["id", "concept", "box"],
                                "properties": {"id": {"type": "string"}, "concept": {"type": "string"},
                                               "box": {"$ref": "#/$defs/box"}}}},
          "text_capture": {"type": "object", "required": ["reason", "text_sha256"], "description": "Optional, on a research page whose image could not be rendered: its readable text was set on plain pages by code; the citation box is not applicable (a recorded limitation) and reason is the render failure."},
          "research_checks": {"type": "object", "description": "Optional, on a page fetched by the research agent: the capture checks run on it (capture_incomplete; hidden or sub-2pt text) with their results."}
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "kind", "result", "reason", "compared", "code_ref"],
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "kind": {"const": "Code"},
        "result": {"enum": ["pass", "fail", "could_not_run", "not_needed", "unresolved"]},
        "reason": {"type": "string"},
        "compared": {
          "type": "object",
          "additionalProperties": false,
          "required": ["looked_for", "found"],
          "properties": {
            "looked_for": {"type": ["string", "null"]},
            "found": {"type": ["string", "null"]},
            "box": {"$ref": "#/$defs/box"},
            "word_ids": {"type": "array", "items": {"type": "string"}},
            "timing": {"type": "object", "additionalProperties": false,
                        "required": ["wording", "start", "end", "precision"],
                        "properties": {"wording": {"type": ["string", "null"]},
                                       "start": {"type": ["string", "null"], "format": "date"},
                                       "end": {"type": ["string", "null"], "format": "date"},
                                       "precision": {"enum": ["day", "period", "unresolved"]}}}
          }
        },
        "near_match": {"type": ["string", "null"], "description": "Optional. Quote check on a near miss: the page's own wording for the run that nearly matches the quote."},
        "differs": {"type": "array", "description": "Optional. With near_match: [quote_word, page_word] for each word of that run that differs.",
                    "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "items": false, "minItems": 2}},
        "code_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "function"],
          "properties": {
            "file": {"$ref": "#/$defs/rel_path"},
            "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        },
        "assessment": {
          "type": "object", "additionalProperties": false,
          "required": ["inputs", "evidence", "checker_version", "input_sha256", "assessment_sha256"],
          "properties": {
            "inputs": {"type": "object"},
            "evaluation_mode": {"oneOf": [{"type": "object", "additionalProperties": false,
                                             "required": ["date_person_selected"],
                                             "properties": {"date_person_selected": {"type": "boolean"}}},
                                            {"type": "null"}]},
            "evidence": {"type": "object", "additionalProperties": false,
                          "required": ["source_id", "page_number", "image_sha256", "words_sha256",
                                      "derived_words", "capture_completeness"],
                          "properties": {"source_id": {"type": ["string", "null"]},
                                         "page_number": {"type": ["integer", "null"]},
                                         "image_sha256": {"type": ["string", "null"]},
                                         "words_sha256": {"type": ["string", "null"]},
                                         "words_used_sha256": {"type": ["string", "null"]},
                                         "words_used": {"oneOf": [{"type": "object", "additionalProperties": false,
                                                                    "required": ["file", "sha256", "kind"],
                                                                    "properties": {"file": {"type": ["string", "null"]},
                                                                                   "sha256": {"type": ["string", "null"]},
                                                                                   "kind": {"enum": ["captured", "derived", "image", "unavailable", "unverified"]}}},
                                                               {"type": "null"}]},
                                         "derived_words": {"type": ["object", "null"]},
                                         "visual_evidence": {"oneOf": [{"type": "object", "additionalProperties": false,
                                           "required": ["origin", "overlays_supported", "reason"],
                                           "properties": {"origin": {"enum": ["text_layer", "hidden_text", "approximate", "no_text_layer"]},
                                             "overlays_supported": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}},
                                           {"type": "null"}]},
                                         "capture_completeness": {"type": ["object", "null"]},
                                         "scanned": {"type": ["boolean", "null"]},
                                         "regions": {"type": ["array", "null"]},
                                         "width_pt": {"type": ["number", "null"]},
                                         "height_pt": {"type": ["number", "null"]}}},
            "checker_version": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "output": {"type": "object", "additionalProperties": false,
                       "required": ["result", "reason", "compared"],
                       "properties": {"result": {"enum": ["pass", "fail", "could_not_run", "not_needed"]},
                                      "reason": {"type": "string"}, "compared": {"type": "object"},
                                      "near_match": {"type": "string"},
                                      "differs": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}}},
            "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "assessment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "trail_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "tag", "who", "text", "at"],
      "properties": {
        "step": {"type": "string"},
        "tag": {"enum": ["Model", "Code", "Person"]},
        "who": {"type": "string", "minLength": 1, "not": {"pattern": " and "},
                "description": "Exactly one actor, and the right kind for the tag."},
        "text": {"type": "string"},
        "at": {"$ref": "#/$defs/timestamp"},
        "tokens": {
          "description": "Optional. On a Model step: the tokens of the call (prompt and completion; call_rows when one call proposed several rows and this step carries its even share). On the first step, Instructions sent: the prompt's token count, completion null. null when not recorded.",
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["prompt", "completion"],
             "properties": {
               "prompt": {"type": "integer", "minimum": 0},
               "completion": {"type": ["integer", "null"], "minimum": 0},
               "call_rows": {"type": "integer", "minimum": 2}
             }}
          ]
        },
        "cost_usd": {"type": ["number", "null"], "minimum": 0,
                     "description": "Optional. On a Model step: the cost of its tokens from the fixed price table in runs/prices.py; null when not recorded."}
      },
      "allOf": [
        {"if": {"properties": {"tag": {"const": "Model"}}, "required": ["tag"]},
         "then": {"properties": {"who": {"$ref": "#/$defs/model_name"}}}},
        {"if": {"properties": {"tag": {"const": "Code"}}, "required": ["tag"]},
         "then": {"properties": {"who": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$",
                                          "description": "A Python name: a check function or a module."}}}},
        {"if": {"properties": {"tag": {"const": "Person"}}, "required": ["tag"]},
         "then": {"properties": {"who": {"const": "person"}}}}
      ]
    },
    "model_name": {"enum": ["Muse Glimmer", "Muse Spark", "Muse Wonder", "Muse Spark Open", "SAM 3.1"]},
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "column", "value", "box", "status", "checks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "column": {"type": "string"},
        "value": {"type": ["string", "null"]},
        "box": {"$ref": "#/$defs/box"},
        "status": {"enum": ["matched", "proposed", "failed", "undecided"]},
        "disagreement": {"$ref": "#/$defs/disagreement"},
        "check_history": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "disagreement": {
      "description": "Optional; set on an undecided row or value: the field the two readers disagreed on and what each read. Only a fix of this field settles the disagreement. `also` lists any other fields they read differently.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "first_reader", "second_reader"],
      "properties": {
        "field": {"type": "string"},
        "first_reader": {"type": ["string", "array", "null"], "items": {"type": "string"}},
        "second_reader": {"type": ["string", "array", "null"], "items": {"type": "string"}},
        "also": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "first_reader", "second_reader"],
          "properties": {"field": {"type": "string"}, "first_reader": {"type": ["string", "array", "null"], "items": {"type": "string"}},
                         "second_reader": {"type": ["string", "array", "null"], "items": {"type": "string"}}}}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "page_number", "title", "columns", "model", "instructions", "status", "problem", "rows"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "page_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "tag"],
          "properties": {"name": {"type": "string"}, "tag": {"const": "Model"}}
        },
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_sha256", "prompt_text"],
          "properties": {
            "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "prompt_text": {"type": "string"}
          }
        },
        "status": {"enum": ["checked", "unreadable"], "description": "unreadable: the model's answer could not be understood, so rows is empty."},
        "problem": {"type": ["string", "null"]},
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "cells"],
            "properties": {
              "label": {"type": "string"},
              "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}
            }
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ticker", "company", "event_type", "title", "date_text", "date", "quote", "source_id",
                   "page_number", "box", "proposed_by", "status", "group", "reason", "sample", "checks", "trail"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "ticker": {"type": "string"},
        "company": {"type": "string"},
        "event_type": {"type": "string", "pattern": "^[a-z_]+$"},
        "escalation_context_changes": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["field", "before", "after"],
            "properties": {"field": {"type": "string"},
                           "before": {},
                           "after": {}}
          },
          "description": "Proposed interpretation differences retained for human review, not code-caught mistakes."
        },
        "escalation_proposal": {
          "type": "object", "additionalProperties": false,
          "required": ["model", "at", "source_id", "page_number", "proposal", "raw_response"],
          "properties": {"model": {"type": "string"}, "at": {"type": "string"},
                         "source_id": {"type": ["string", "null"]}, "page_number": {"type": ["integer", "null"]},
                         "proposal": {"type": "object"}, "raw_response": {"type": ["string", "null"]},
                         "comparison": {"type": "object", "additionalProperties": false,
                                        "required": ["before", "after"],
                                        "properties": {"before": {"$ref": "#/$defs/check"}, "after": {"$ref": "#/$defs/check"}}}},
          "description": "Actual bounded repair answer, distinct from copied original context and never semantic acceptance."
        },
        "timing_proposal": {
          "type": "object", "additionalProperties": false,
          "required": ["model", "at", "source_id", "page_number", "proposal"],
          "properties": {"model": {"type": "string"}, "at": {"type": "string"},
                         "source_id": {"type": ["string", "null"]}, "page_number": {"type": ["integer", "null"]},
                         "proposal": {"type": "object"}},
          "description": "Raw timing answer retained beside the original event; not proof that two passages describe the same event."
        },
        "second_reader_proposal": {
          "type": "object", "additionalProperties": false, "required": ["model", "at", "proposal"],
          "properties": {"model": {"type": "string"}, "at": {"type": "string"}, "proposal": {"type": "object"}},
          "description": "Unmodified matched second-reader proposal; retained separately, never a check result."
        },
        "type_hint": {"type": ["string", "null"]},
        "relevance": {"type": ["string", "null"], "description": "Reader's proposed relevance, not a check result."},
        "conditions": {"type": ["array", "null"], "items": {"type": "string"}, "description": "Reader's extracted qualifications. Empty means none extracted, not unconditional."},
        "subject_company": {"type": ["string", "null"]},
        "relation": {"type": ["string", "null"], "description": "Proposed relationship or stated uncertainty, not established identity."},
        "type_reason": {"enum": ["agency_not_established", "event_type_not_established", "event_mentioned_not_established", null],
                        "description": "Why the type (or part of it) is not established, from the quote's words; null when nothing is missing."},
        "title": {"type": "string"},
        "date_text": {"type": ["string", "null"]},
        "date": {"oneOf": [{"$ref": "#/$defs/iso_date"}, {"type": "null"}],
                 "description": "The exact day; when date_end is set, the first day of the period."},
        "date_end": {"oneOf": [{"$ref": "#/$defs/iso_date"}, {"type": "null"}],
                     "description": "Optional. The last day of the period when the source names a period (\"Q3 2027\"); null for an exact day."},
        "quote": {"type": ["string", "null"]},
        "program": {"type": ["string", "null"], "description": "Optional. The drug or program name as printed (\"PN-8047\"); not an input to the literal date check."},
        "indication": {"type": ["string", "null"], "description": "Optional. The disease or condition the program is for, as printed; the scorer and the key may alias it like the program."},
        "found_by": {"enum": ["reader", "coverage", "second_reader"], "description": "Optional. \"coverage\": code found the dated sentence the reader did not turn into a row (checks/coverage.py); no model proposed it. \"second_reader\": only the second reader read it (runs/compare.py)."},
        "raw_sentence": {"type": "string", "description": "Optional. On a coverage row: the sentence exactly as the page prints it; `quote` and the title hold it cleaned."},
        "kind": {"enum": ["missed"], "description": "Optional. \"missed\" on a coverage row: a possible event neither reader turned into a row."},
        "status_text": {"type": "string", "description": "Optional. What the pane says about a coverage row."},
        "guess": {"type": "object", "additionalProperties": false,
                  "properties": {"date_text": {"type": ["string", "null"]}, "date": {"type": ["string", "null"]},
                                 "date_end": {"type": ["string", "null"]}, "program": {"type": ["string", "null"]},
                                 "event_type": {"type": ["string", "null"]}},
                  "description": "Optional. On a coverage row: what code could read from the sentence, every field a guess (null when unseen)."},
        "source_id": {"$ref": "#/$defs/id"},
        "page_number": {"type": "integer", "minimum": 1},
        "box": {"$ref": "#/$defs/box"},
        "proposed_by": {"type": "string"},
        "disagreement": {"$ref": "#/$defs/disagreement"},
        "status": {"enum": ["matched", "proposed", "failed", "unreadable", "undecided"]},
        "group": {"enum": ["kept", "corrected", "removed", "unverified", "open"]},
        "reason": {"type": "string"},
        "past_exclusion_proposal": {"type": "string", "description": "Optional past-date note for human review. A literal date match does not authorize exclusion."},
        "sample": {"type": "boolean"},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "check_history": {"type": "array", "items": {"$ref": "#/$defs/check"},
                          "description": "Optional transient load view: checks replaced by a bound re-check remain available as history."},
        "research": {"type": "object", "required": ["label", "revision", "evidence"],
                     "description": "Optional. On a row proposed by the research agent: its label (never 'verified'), proposal revision, every evidence span with its own checks, page capture issues, linked near-duplicates and the revision history.",
                     "properties": {"label": {"const": "Agent research — not independently reviewed"},
                                    "revision": {"type": "integer", "minimum": 1},
                                    "ticker": {"type": "string"}, "call_id": {"type": "string"},
                                    "primary_span_index": {"type": "integer", "minimum": 0},
                                    "conditions_state": {"enum": ["not_established", "none_stated", "stated"],
                                                         "description": "conditions null = not established; [] = none stated in the assessed support; never converted into each other."},
                                    "evidence": {"type": "array", "minItems": 1, "items": {
                                      "type": "object", "required": ["source_id", "page_number", "quote", "roles", "word_ids", "quote_match", "printed_quote_match"],
                                      "properties": {"source_id": {"$ref": "#/$defs/id"}, "page_number": {"type": "integer", "minimum": 1},
                                                     "quote": {"type": "string", "minLength": 1},
                                                     "roles": {"type": "array", "items": {"enum": ["actor", "program", "indication", "action", "timing", "condition", "relationship", "number", "context"]}},
                                                     "word_ids": {"type": ["array", "null"], "items": {"type": "string", "pattern": "^w[0-9]+$"}},
                                                     "quote_match": {"type": "string"}, "printed_quote_match": {"type": "string"},
                                                     "unknown_word_ids": {"type": "array", "items": {"type": "string"}},
                                                     "capture_incomplete": {"type": ["string", "null"]}, "hidden_text": {"type": ["string", "null"]}}}},
                                    "issues": {"type": "array", "items": {"type": "object", "required": ["code", "message"],
                                               "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
                                    "timing_span_index": {"type": ["integer", "null"], "minimum": 0},
                                    "timing": {"type": "object", "required": ["source_id", "page_number", "quote", "published_date", "image_sha256", "words_sha256", "words_used"],
                                               "description": "When date_match ran on a separate timing span: that span's source, page, quote, published date and consumed words; the date check is bound to it."},
                                    "near_duplicates": {"type": "array", "items": {"type": "string"}},
                                    "revisions": {"type": "array", "items": {"type": "object", "required": ["revision"],
                                                  "properties": {"revision": {"type": "integer", "minimum": 1}}}},
                                    "feedback": {"type": "object", "required": ["repair_open"], "properties": {"repair_open": {"type": "boolean"}}}}},
        "trail": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [{"allOf": [{"$ref": "#/$defs/trail_step"}, {"properties": {"step": {"anyOf": [{"const": "Instructions sent"}, {"pattern": "^Sent the page"}]}}}]}],
          "items": {"$ref": "#/$defs/trail_step"}
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "rule", "reason", "by"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "rule": {"enum": ["third_party_calendar_only", "event_in_past", "person_removed", "outside_time_window"]},
        "reason": {"type": "string"},
        "by": {"enum": ["code", "person"]}
      }
    },
    "mistake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "what_changed", "caught_by"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "what_changed": {"type": "string"},
        "caught_by": {"enum": ["code", "second_reader", "person"]},
        "type": {"enum": ["WRONG_VALUE", "WRONG_ROW", "WRONG_COLUMN", "BOX_DRIFT", "QUOTE_NOT_ON_PAGE",
                          "DATE_NOT_IN_QUOTE", "PERIOD_MISREAD", "DATE_IN_PAST", "WRONG_EVENT_TYPE",
                          "WRONG_COMPANY", "SOURCE_NOT_ALLOWED", "DUPLICATE", "UNREADABLE_OUTPUT",
                          "MISSED_DATED_SENTENCE"],
                 "description": "Optional. The mistake type code (accuracy/types.py); the mistake log counts by type, model and who caught it."}
      }
    }
  }
}
